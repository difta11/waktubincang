{
  "rules": {
    ".read": true,
    ".write": true,

    "sessions": {
      "$sessionId": {
        ".read": true,
        ".write": true,
        "events": {
          ".indexOn": ["timestamp_server", "created_order", "client_event_id", "device_id"],
          "$eventId": {
            ".validate": "!newData.exists() || newData.hasChildren(['event_id','session_id','timestamp_server','local_timestamp','device_id','device_name','operator_name','event_type','note'])",
            "event_id": { ".validate": "newData.isString() && newData.val() === $eventId" },
            "session_id": { ".validate": "newData.isString() && newData.val() === $sessionId" },
            "timestamp_server": { ".validate": "newData.isNumber()" },
            "local_timestamp": { ".validate": "newData.isNumber()" },
            "device_id": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128" },
            "device_name": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "operator_name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "event_type": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "frame": { ".validate": "newData.isNumber()" },
            "end_frame": { ".validate": "newData.isNumber()" },
            "timecode": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "color": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "client_event_id": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 160" },
            "created_order": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": true }
          }
        },
        "devices": {
          ".indexOn": ["status", "last_seen", "device_id"],
          "$deviceId": {
            ".validate": "!newData.exists() || newData.hasChildren(['device_id','device_name','operator_name','status','last_seen'])",
            "device_id": { ".validate": "newData.isString() && newData.val() === $deviceId" },
            "device_name": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "operator_name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "status": { ".validate": "newData.val() === 'online' || newData.val() === 'offline'" },
            "last_seen": { ".validate": "newData.isNumber()" },
            "last_seen_local": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": true }
          }
        },
        "state": {
          "timecode": {
            ".validate": "!newData.exists() || newData.hasChildren(['running'])",
            "running": { ".validate": "newData.isBoolean()" },
            "startTime": { ".validate": "newData.isNumber()" },
            "frameOffset": { ".validate": "newData.isNumber()" },
            "frameAtStop": { ".validate": "newData.isNumber()" },
            "reset": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": true }
          }
        },
        "settings": {
          ".validate": "!newData.exists() || newData.hasChildren(['fps','fmt'])",
          "fps": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 240" },
          "fmt": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "$other": { ".validate": true }
        },
        "$other": { ".validate": true }
      }
    },

    "session1": {
      "users": {
        ".indexOn": ["lastSeen", "deviceId"],
        "$userKey": {
          ".read": true,
          ".write": true,
          "$other": { ".validate": true }
        }
      },
      "blocks": {
        ".read": true,
        "$blockId": {
          ".write": true,
          "markings": {
            ".indexOn": ["ts", "client_event_id", "event_id"],
            "$markingId": {
              ".write": true,
              "$other": { ".validate": true }
            }
          },
          "$other": { ".validate": true }
        }
      },
      "timecodes": {
        "$blockId": {
          ".read": true,
          ".write": true,
          "$other": { ".validate": true }
        }
      },
      "settings": {
        "$blockId": {
          ".read": true,
          ".write": true,
          "$other": { ".validate": true }
        }
      }
    }
  }
}
